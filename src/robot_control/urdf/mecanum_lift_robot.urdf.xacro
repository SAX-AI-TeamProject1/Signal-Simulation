<?xml version="1.0"?>
<!--
  mecanum_lift 로봇: mecanum_lift 메시를 "외형"으로 쓰고, 구동은 robot.urdf.xacro와
  동일한 자체 diff-drive 구조를 얹는다. robot.urdf.xacro(OGV 버전)에서 밤새 검증된
  chassis/바퀴/캐스터/DiffDrive 구조를 그대로 재사용하고 외형 메시만 교체했다.
  라이다 + 카메라 센서 포함 (Method B — 실제 물리 모델 + 실제 센서).

  치수는 worlds/navi_factory/models/mecanum_lift/model.sdf 의 collision(scissor
  박스 2.04x0.936x0.6)을 참고해 대략적인 비율로 잡았다.
-->
<robot name="mecanum_lift_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="ns" default="robot2"/>

  <!-- ===== 외형 메시 (deco_forklift 재사용) ===== -->
  <!-- worlds/navi_factory 의 deco_forklift_ogv 소품과 같은 glb를 그대로 쓴다. 그 소품은
       scale/offset 없이(즉 1:1 실척, 원점=바닥) 배치돼 있었으므로 여기서도 동일하게
       회전·오프셋 없이 얹는다. 실제 지게차 실척(길이 2.4 x 폭 1.4 x 높이 2.06m)이라
       지금 chassis collision(2.0x0.9x0.6)/바퀴 배치보다 눈에 띄게 크고 높다 — 요청은
       "메시 교체"까지라 물리 치수(collision/wheel_sep 등)는 안 건드렸고, 시각적으로
       안 맞으면 후속으로 chassis 치수도 지게차 실척에 맞춰 키우는 작업이 필요하다. -->
  <xacro:property name="lift_mesh" value="model://Forklift/base_visual.glb"/>
  <xacro:property name="lift_scale" value="1 1 1"/>
  <xacro:property name="mesh_roll" value="0"/>
  <xacro:property name="mesh_z_offset" value="0"/>
  <!-- base_visual.glb 안에 Y축 +90도 회전이 이미 baked돼 있다(glTF 노드 rotation
       [0, 0.7071, 0, 0.7071] 확인됨). 노드 rotation+scale을 반영해 정점을 직접
       변환해보면 mesh_yaw=0일 때 포크(바닥 근처 저-z 밴드가 몸통보다 튀어나온 방향)가
       로컬 +Y를 향한다 — 로봇 전진(+X, DiffDrive)과 90도 어긋난다. -1.5708(-90도)을
       주면 포크가 +X를 향하도록 검증했다. -->
  <xacro:property name="mesh_yaw" value="-1.5708"/>

  <!-- ===== 차체 실측 치수 =====
       외형 메시를 지게차로 바꾸면서 물리 치수는 옛 값(2.0x0.9x0.6)이 남아 있었다.
       그 값들의 근거가 사라졌으므로 실제 렌더되는 메시를 시뮬레이션에서 직접 쟀다:
       라이다를 차체 밖 6m 지점(정면 x=+6, 측면 y=+6)에 두고 자기 몸을 스캔해
       높이별 실루엣을 읽는 방식이다. 계산으로 glTF 좌표를 변환해 보기도 했는데
       두 번 다 실측과 안 맞아서(Y-up 변환 가정 문제) 계산값은 쓰지 않았다.

         높이 0.3m : x[-0.85, 1.10]  y[-0.52, 0.57]
         높이 0.6m : x[-0.80, 1.10]  y[-0.52, 0.55]
         높이 1.5m : x[-0.67, 0.96]  y[-0.48, 0.49]
         위끝      : z=2.1m 에는 반사 있고 z=2.3m 에는 없음

       => 길이 1.95, 폭 1.09, 높이 약 2.2. 앞뒤로는 원점 기준 앞이 더 길다
       (중심이 x=+0.125). 월드 소품 deco_forklift_ogv 의 collision box 에 적힌
       2.4x1.4x2.06 은 이 메시의 실제 크기가 아니다 — 그 값을 믿고 맞추면 안 된다. -->
  <xacro:property name="body_len"    value="1.95"/>
  <xacro:property name="body_wid"    value="1.09"/>
  <xacro:property name="body_x"      value="0.125"/>  <!-- 차체 중심의 x 오프셋 -->
  <xacro:property name="body_top"    value="2.2"/>
  <!-- 지면과 차체 바닥 사이 간격. 0 으로 두면 collision 박스가 바닥에 먼저 닿아
       바퀴가 뜨고 로봇이 굴러가지 않는다. -->
  <xacro:property name="ground_gap"  value="0.15"/>

  <!-- ===== 구동 파라미터 ===== -->
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width"  value="0.12"/>
  <!-- 바퀴가 차체 폭(1.09) 밖으로 튀어나오지 않게 잡는다: 1.3 이던 예전 값은
       옛 차체(폭 0.9) 기준이라 지금 메시에서는 바퀴가 좌우로 0.17m 씩 삐져나왔다.
       0.95 면 바깥면이 0.95/2+0.12/2 = 0.535 로 차체 반폭 0.545 안에 들어온다.
       전복 걱정은 이 모델에선 크지 않다 — box_inertia 매크로가 <origin> 을 주지
       않아 무게중심이 링크 원점(지면 높이)에 있기 때문이다. -->
  <xacro:property name="wheel_sep"    value="0.95"/>
  <xacro:property name="caster_radius" value="0.07"/>
  <!-- 캐스터도 차체 안쪽으로. 0.95 였을 때 뒤 캐스터(-0.95)가 차체 뒤끝(-0.85)
       밖으로 나가 허공에 떠 있었다. 앞뒤 짧은 쪽(0.85)에서 여유를 둔 값이다. -->
  <xacro:property name="caster_x"      value="0.72"/>

  <xacro:property name="base_mass"   value="25.0"/>
  <xacro:property name="wheel_mass"  value="1.5"/>

  <!-- ===== 관성 매크로 ===== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cyl_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5.0}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5.0}" iyz="0" izz="${2*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ===== base_link: 질량 없는 루트(참조 프레임 전용) ===== -->
  <link name="base_link"/>

  <joint name="base_to_chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== chassis (지면 기준, 원점 z=0) ===== -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 ${mesh_z_offset}" rpy="${mesh_roll} 0 ${mesh_yaw}"/>
      <geometry>
        <mesh filename="${lift_mesh}" scale="${lift_scale}"/>
      </geometry>
    </visual>
    <!-- collision 박스를 실측 치수로. 바닥에서 ground_gap 만큼 띄우고 body_top 까지
         올린다 — 위끝을 2.2 로 잡으면 지게차 마스트까지 포함되므로, 로봇이 선반
         아래를 통과하던 게 이제 막힐 수 있다(예전 박스는 높이 0.6 뿐이었다). -->
    <xacro:property name="body_hgt" value="${body_top - ground_gap}"/>
    <collision>
      <origin xyz="${body_x} 0 ${ground_gap + body_hgt/2}" rpy="0 0 0"/>
      <geometry><box size="${body_len} ${body_wid} ${body_hgt}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${body_len}" y="${body_wid}" z="${body_hgt}"/>
  </link>

  <!-- ===== 구동 바퀴 매크로 ===== -->
  <xacro:macro name="drive_wheel" params="prefix side_y">
    <link name="${prefix}_wheel">
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>
    <gazebo reference="${prefix}_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="chassis"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="0 ${side_y} ${wheel_radius - 0.01}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel prefix="left"  side_y="${ wheel_sep/2}"/>
  <xacro:drive_wheel prefix="right" side_y="${-wheel_sep/2}"/>

  <!-- ===== 캐스터 매크로 (앞/뒤 지지, 마찰 0) ===== -->
  <xacro:macro name="caster" params="prefix px">
    <link name="${prefix}_caster">
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="0.5" r="${caster_radius}"/>
    </link>
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="chassis"/>
      <child  link="${prefix}_caster"/>
      <origin xyz="${px} 0 ${caster_radius + 0.02}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${prefix}_caster">
      <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster prefix="front" px="${ caster_x}"/>
  <xacro:caster prefix="back"  px="${-caster_x}"/>

  <!-- ===== 카메라 링크 ===== -->
  <link name="camera_link">
    <xacro:box_inertia m="0.05" x="0.02" y="0.06" z="0.02"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child  link="camera_link"/>
    <origin xyz="1.0 0 1.0" rpy="0 0 0"/>
  </joint>

  <!-- ===== 라이다 링크 ===== -->
  <!-- 앞 범퍼, 다리 높이. gpu_lidar 는 collision 이 아니라 visual 을 렌더링해서
       맞히므로, collision 박스를 피하는 것만으로는 자기 몸을 안 보게 할 수 없다.
       위치를 시뮬레이션에서 후보별로 재 봤다(막힌 광선 비율 / 연속으로 트인 각):

         (1.05, 0, 0.50) 이전 값   57% 막힘   ±75.7도
         (1.25, 0, 0.35) 이 값     41% 막힘   ±105.8도
         (1.25, 0, 0.60)           41% 막힘   ±105.8도
         (0.125, 0, 2.40) 마스트 위 0% 막힘   완전 360도

       마스트 위가 유일하게 진짜 360도지만, 지면 2.4m 높이의 수평 단면이라 사람도
       팔레트도 콘도 그 아래로 지나간다. 신호수 안전이 목적인 1단계에는 못 쓴다.
       실물 AGV 도 항법용 라이다는 마스트 위, 안전용 스캐너는 낮게 따로 단다.
       그래서 안전용 쪽을 골랐다: x=1.25 는 차체 앞끝(1.10) 바로 앞이고,
       z=0.35 는 사람 다리와 팔레트가 걸리는 높이다.
       뒤쪽 41% 는 차체에 막혀 있다. 뒤 범퍼에 한 대를 더 다는 방법(실물 AGV 의
       2대 배치)도 있지만, 후진할 일이 없다고 보고 대신 아래에서 스캔 각을
       전방 180도로 잘랐다. -->
  <link name="lidar_link">
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.05"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child  link="lidar_link"/>
    <origin xyz="1.25 0 0.35" rpy="0 0 0"/>
  </joint>

  <!-- ================= Gazebo (gz-sim / Harmonic) ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <topic>$(arg ns)/cmd_vel</topic>
      <odom_topic>$(arg ns)/odom</odom_topic>
      <!-- 프레임 이름에 ns 접두어를 붙인다. tf2_ros 가 토픽 이름을 절대 경로 "/tf" 로
           박아 놓아서(transform_broadcaster.hpp) 로봇이 여러 대여도 tf 는 전부 한
           토픽에 섞여 들어온다 — 토픽으로는 못 가르고 프레임 "이름"으로만 갈린다.
           launch 의 robot_state_publisher 에 준 frame_prefix 와 같은 값이라야
           odom→base_link 와 base_link→chassis 가 한 트리로 이어진다. -->
      <frame_id>$(arg ns)/odom</frame_id>
      <child_frame_id>$(arg ns)/base_link</child_frame_id>
      <tf_topic>$(arg ns)/tf</tf_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>$(arg ns)/joint_states</topic>
    </plugin>
    <!-- odom(바퀴 적산치)은 슬립이 있으면 실제 위치와 어긋난다. 웨이포인트
         추종은 절대 좌표(월드 프레임) 기준이라야 하므로, 적산 오차 없는
         진짜(ground-truth) pose를 별도로 발행해 그걸 쓴다. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <publish_pose>true</publish_pose>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="sim_camera" type="camera">
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <!-- 다른 센서/플러그인(scan, cmd_vel, odom)과 동일하게 ns로 분리 — 이전엔 그냥
           camera/image로 전역 토픽이라 로봇이 여러 대면 충돌할 뻔했다. -->
      <topic>$(arg ns)/camera/image</topic>
      <!-- gz_frame_id 를 반드시 넣는다: 없으면 ROS 로 넘어온 Image 의 frame_id 가
           "mecanum_lift_robot/camera_link/sim_camera" 같은 gz 내부 스코프 이름이 되어
           tf 조회(카메라 좌표 → base_link)가 실패한다. -->
      <!-- ns 접두어는 위 DiffDrive frame_id 와 같은 이유 — rsp 의 frame_prefix 가
           만드는 이름(robot2/camera_link)과 글자 하나까지 같아야 tf 조회가 붙는다. -->
      <gz_frame_id>$(arg ns)/camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- update_rate/samples를 낮게: gpu_lidar는 스캔마다 씬을 렌더링해서 GPU 가속
       없이는 부하가 크다 (docs/gazebo-control-guide.md §7 권장값). -->
  <!-- 라이다가 real-time factor 저하의 주범인지 확인해봤는데 아니었다(꺼도 배속
       그대로) — 병목은 월드의 소품 개수(충돌 계산량) 쪽으로 보인다. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>$(arg ns)/scan</topic>
      <!-- 카메라와 같은 이유. 없으면 LaserScan 의 frame_id 가 gz 내부 스코프 이름이 되어
           Nav2 가 tf 조회에 실패한다. -->
      <gz_frame_id>$(arg ns)/lidar_link</gz_frame_id>
      <!-- 5Hz/180샘플에서 10Hz/360샘플로 올렸다. 이 스캔이 비상정지의 유일한
           근거가 되면서 두 수치가 다 모자랐다:
             - 5Hz 는 최악 200ms 지연이라 1m/s 로 달리면 20cm 를 눈 감고 간다.
             - 180샘플을 360도에 뿌리면 2도 간격이라, 폭 0.4m 인 사람이 10m 에서
               레이 1개에만 걸린다. 1도 간격이면 같은 거리에서 2개, 5m 에서 5개다.
           라이다를 꺼도 real-time factor 가 그대로였다는 실측이 있어(병목은 월드의
           소품 충돌 계산) 이 정도 증량은 감당 가능하다고 판단했다. -->
      <update_rate>10</update_rate>
      <lidar>
        <!-- 360도가 아니라 전방 180도(±90도)만 스캔한다. 위 실측대로 이 장착
             위치에서 트인 구간은 ±105.8도 뿐이고 나머지 41% 는 자기 차체를
             때리는 광선이었다 — 그 41% 는 정보가 아니라 노이즈다. ±90도 는 그
             트인 구간 안에 완전히 들어가므로 자기 몸 반사가 남지 않는다.
             샘플 수는 360 그대로 둔다: 같은 개수를 절반 각에 뿌리니 간격이
             1도에서 0.5도로 좁아진다(10m 거리에서 폭 0.4m 인 사람에 광선 2개
             → 4개). 대신 뒤쪽은 영구히 못 본다 — 후진 계획이 없어서 고른
             맞바꿈이고, 후진이 생기면 뒤 범퍼에 두 번째 라이다를 다는 쪽이지
             이 각을 되돌리는 게 아니다(되돌려 봐야 자기 차체만 보인다). -->
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-1.5708</min_angle>
            <max_angle>1.5708</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>20.0</max>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
