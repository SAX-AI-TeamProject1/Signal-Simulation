<?xml version="1.0"?>
<!--
  안정용 평평한 바닥판 (collision 전용).
  창고 메시 바닥(warehouse_colision.stl)이 접촉 불안정해 로봇이 넘어지는 문제를 격리/해결하려고,
  창고 바닥 높이(z≈0.2)에 완벽한 평면 collision 을 하나 깐다.
  - 시각(visual) 없음 → 창고 외형 안 가림. 물리적으로만 바닥 역할.
  - 스폰 위치는 launch 에서 -z 로 준다.
  - <plane> 이 아니라 얇은 <box>(두께 0.1m)를 쓴다: 로봇 바퀴(cylinder)가 <plane>과 축이
    완벽하게 평행/정렬된 채로 접촉하면 ODE 의 cylinder-vs-plane 충돌 코드가 접촉 노멀을
    정규화하다 길이 0 벡터를 만나 "ODE INTERNAL ERROR 1: assertion !bSafeNormalize3Fault
    failed in dxNormalize3()" 로 죽는 잘 알려진 문제가 있다. box-vs-cylinder 충돌 코드는
    이 degenerate 케이스가 없어 회피된다. collision 의 pose 로 박스를 반두께(0.05m)만큼
    아래로 내려서, 이전 <plane> 이 있던 높이(link 원점)에 박스 윗면이 오도록 맞췄다.
-->
<sdf version="1.9">
  <model name="flat_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <!-- 두께 4m. 예전에는 0.1m 였는데, 3.3m/s 로 달리다 차체가 크게 기울면
             물리 스텝 한 번에 차체 모서리가 이 얇은 판을 관통했다. 실측 예:
             피치 18.3도 / 원점 z=0.254 일 때 차체 박스 뒤아래 모서리가 z=0.13 —
             판(0.15~0.25) 아래로 2cm 빠져나가 있었고, 로봇은 바퀴만 20rad/s 로
             헛돌며 그 자리에 박혀 있었다(토크를 끊어도 자세가 안 풀렸다).
             관통한 물체는 솔버가 어느 쪽으로 밀어낼지 몰라 끼거나 튕겨 나간다 —
             z=2.15m 까지 날아간 사건도 같은 뿌리로 보인다.
             두께를 키워도 비용은 없다: static 박스이고, 월드 모델 196개가 전부
             static 이라 판 안에 묻히는 소품들과는 접촉 계산 자체가 없다.
             pose 를 반두께(-2)로 내려서 윗면 높이는 예전과 똑같이 유지한다. -->
        <pose>0 0 -2 0 0 0</pose>
        <geometry>
          <box><size>200 200 4</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
