<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_control</name>
  <version>0.0.0</version>
  <description>K-NAVI robot body and wiring: robot URDF (xacro) and the bridge/twist_mux/ground config the bringup consumes</description>
  <maintainer email="shp9826@naver.com">sho</maintainer>
  <license>MIT</license>

  <!--
    런타임 의존성 (exec_depend): "이 패키지를 실행할 때 이런 다른 패키지가 깔려 있어야 한다"는 선언.
    (exec_depend = 실행 의존성. 빌드타임 코드가 없으므로 build_depend 는 불필요)

    이 패키지는 실행하는 게 없다 — 파이썬 노드도 없고, bringup.launch.py 도 knavi_bringup 으로
    옮겼다. 남은 건 urdf 와 config(bridge.yaml, twist_mux.yaml, flat_ground.sdf)뿐이고, 그
    파일들을 실제로 읽어 노드를 띄우는 건 knavi_bringup 이다. 그래서 노드를 띄우는 데 필요한
    패키지(rclpy, robot_state_publisher, ros_gz_sim, ros_gz_bridge, twist_mux, 메시지 타입들)는
    전부 knavi_bringup/package.xml 이 선언한다 — 여기 남겨 두면 실행하지도 않는 걸 요구하는
    거짓 선언이 된다. cv_bridge / python3-opencv / std_msgs 는 같은 이유로 signal_vision 이 갖는다.

    xacro 만 남기는 기준: 이 패키지가 가진 파일 자체가 xacro 문법이라, xacro 없이는 urdf 를
    URDF 로 펼칠 수조차 없다. yaml/sdf 는 소비하는 쪽 도구가 읽는 평범한 데이터라 여기 안 적는다.
  -->
  <exec_depend>xacro</exec_depend>              <!-- *.urdf.xacro 를 순수 URDF 로 펼치는 도구 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
