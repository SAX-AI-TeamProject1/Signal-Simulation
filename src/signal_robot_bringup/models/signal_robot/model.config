<?xml version="1.0"?>
<!--
  Required by Gazebo: resolving model://signal_robot means finding a directory
  named signal_robot on GZ_SIM_RESOURCE_PATH and reading this file to learn
  which .sdf to load. Without it the model is simply not found.
-->
<model>
  <name>signal_robot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>SeungHo</name>
    <email>shp9826@naver.com</email>
  </author>

  <description>
    Placeholder differential-drive cargo robot used to prove out the
    signal-command control path.
  </description>
</model>
