<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>signal_robot_bringup</name>
  <version>0.0.1</version>
  <description>
    Launch files, the robot model, and the ROS/Gazebo bridge configuration —
    everything needed to start the simulation. No logic lives here; this package
    only wires the other packages together.
  </description>
  <maintainer email="shp9826@naver.com">SeungHo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Pulled in at launch time, not compile time, hence exec_depend. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>signal_robot_control</exec_depend>
  <exec_depend>aws_robomaker_small_warehouse_world</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
