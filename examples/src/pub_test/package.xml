<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pub_test</name>
  <version>0.0.0</version>
  <description>Publish Topic Test</description>
  <maintainer email="shp9826@naver.com">sho</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>custom_msg2</depend>

  <!-- pub_test/vision/ 에 넣은 Signal-Vision 코드가 쓰는 라이브러리.
       apt 패키지가 있어 rosdep이 보통 풀어주는 것만 depend로 선언 (리눅스에서 rosdep resolve로 재확인 필요). -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scikit-learn</exec_depend>
  <exec_depend>python3-opencv</exec_depend>     <!-- 웹캠 캡처(cv2.VideoCapture). contrib 전용 API(cv2.aruco 등) 안 써서 기본판으로 충분 -->

  <!-- 아래는 ROS/Ubuntu apt 저장소에 없는 pip 전용 패키지라 rosdep이 못 찾음
       ("Cannot locate rosdep definition" 에러) - depend로 넣지 말고 scripts/setup_infer_env.py로 pip 설치할 것.
       mediapipe / torch / websocket-client / tqdm: rosdep 데이터베이스에 아예 없음. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
