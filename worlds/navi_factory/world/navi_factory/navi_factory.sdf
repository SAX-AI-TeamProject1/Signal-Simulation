<sdf version='1.10'>
  <world name='warehouse_fuel'>
    <gravity>0 0 -9.8000000000000007</gravity>
    <physics name='default_physics' default='false' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- 실제로 로드되는 physics 플러그인은 dartsim(gz-physics-dartsim)이고, 이 world의
           type='ode'는 DART가 기본으로 쓰는 충돌 검출기 백엔드를 ODE로 고른다는 뜻이다.
           box(flat_ground) vs trimesh(창고 소품 메시들) 충돌에서 ODE의 dCollideBTL이
           "assertion !bSafeNormalize3Fault failed in dxNormalize3()"로 크래시하는 문제가
           있어(어떤 특정 메시인지 특정 못함 — flat_ground가 맵 전체를 덮는 200x200 박스라
           수백 개 소품 메시 중 어디서든 겹칠 수 있음), 충돌 검출기를 bullet으로 바꿔 이
           ODE 전용 코드 경로 자체를 피한다. -->
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <scene>
      <shadows>false</shadows>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
    </scene>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <model name='warehouse'>
      <pose>0 0 -0.1002 0 0 0</pose>
      <self_collide>false</self_collide>
      <link name='warehouse_base'>
        <pose>0 0 0 0 0 0</pose>
        <!-- warehouse_collision(STL mesh) 제거: flat_ground(robot_control/config/flat_ground.sdf,
             launch에서 스폰)가 바닥 충돌을 전담한다. 이 STL 메시가 살아있으면 flat_ground의
             box 충돌체와 겹쳐서(box-vs-trimesh) ODE가 "assertion !bSafeNormalize3Fault failed
             in dxNormalize3()"로 죽는다 — 이 STL 바닥 자체가 불안정해서 애초에 flat_ground를
             추가했던 것이므로(주석 참고), 여기 collision은 완전히 빼는 게 맞다. visual은 그대로
             둬서 외형은 안 바뀐다. -->
        <visual name='warehouse_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>2 2 2</scale>
              <uri>model://warehouse_mohamedazimal27_2x/meshes/warehouse.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <visual name='drop_area_visual'>
          <pose>0 0 0.10100000000000001 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>2 2 2</scale>
              <uri>model://warehouse_mohamedazimal27_2x/meshes/warehouse.dae</uri>
              <submesh>
                <name>drop1</name>
                <center>true</center>
              </submesh>
            </mesh>
          </geometry>
        </visual>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
    </model>
    <model name='hand_signal_spot'>
      <static>true</static>
      <pose>0 40 0.1982676088809967 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
