<sdf version='1.10'>
  <world name='warehouse_fuel'>
    <gravity>0 0 -9.8000000000000007</gravity>
    <physics name='default_physics' default='false' type='ode'>
      <!-- 이 무거운 월드(소품 메시 수백 개)에서 실시간 배속이 실제 시간의
           ~0.5% 수준으로 떨어지는 문제가 있어, 스텝 크기를 10배 늘려(계산량은
           스텝 개수에 비례하지 stepsize 자체엔 크게 안 늘어나므로) 물리
           정밀도를 조금 희생하고 실시간 배속을 개선했었다.
           그런데 스텝이 0.05s로 크면 바퀴-바닥 접촉이 매 스텝 더 큰 침투/보정을
           겪어야 해서 접촉 솔버가 불안정해지기 쉽다 — '스톨' 버그(아래 dart 주석)의
           원인 중 하나로 의심되어, 5배 더 촘촘한 스텝(0.01s)으로 되돌리고 그만큼
           update_rate를 올려(20→100) 같은 실시간 배속(0.05x20=0.01x100=1.0)을
           유지한다. 이러면 스텝당 계산은 가벼워지되(mesh 수는 그대로라 스텝 자체의
           비용은 안 바뀌지만) 스텝 수가 5배 늘어 총 연산량은 늘어난다 — 이 월드가
           여전히 무겁다면 실시간 배속이 다시 떨어질 수 있어 실측이 필요하다. -->
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <!-- 실제로 로드되는 physics 플러그인은 dartsim(gz-physics-dartsim)이고, 이 world의
           type='ode'는 DART가 기본으로 쓰는 충돌 검출기 백엔드를 ODE로 고른다는 뜻이다.
           box(flat_ground) vs trimesh(창고 소품 메시들) 충돌에서 ODE의 dCollideBTL이
           "assertion !bSafeNormalize3Fault failed in dxNormalize3()"로 크래시하는 문제가
           있어(어떤 특정 메시인지 특정 못함 — flat_ground가 맵 전체를 덮는 200x200 박스라
           수백 개 소품 메시 중 어디서든 겹칠 수 있음), 충돌 검출기를 bullet으로 바꿔 이
           ODE 전용 코드 경로 자체를 피한다. -->
      <dart>
        <collision_detector>bullet</collision_detector>
        <!-- '스톨' 버그: 바퀴 관절 속도(joint_states)는 명령대로 정상 회전하는데 차체
             pose_gt는 수십 초씩 그대로인 현상을 실측으로 확인함(직진/제자리회전 모두
             재현, flat_ground 유무 무관, 물리 시계(/clock)는 정상 속도로 흐름 — 즉
             속도저하가 아니라 접지력이 실제로 안 걸리는 상태). mecanum_lift_robot은
             구동바퀴 2개 + 무마찰 캐스터 2개가 동시에 바닥에 닿는 4점 접지라 강체 하나가
             바닥과 과도구속(redundant contact)되는 전형적인 구성인데, dantzig는 이런
             경우 수치적으로 접촉력을 0으로 반환해버리는 퇴화해(degenerate solution)를
             내는 경우가 있다고 알려진 direct LCP solver다. 반복형(iterative) 솔버인
             pgs로 바꿔 이 퇴화해 문제를 회피한다.
        -->
        <solver>
          <solver_type>pgs</solver_type>
        </solver>
      </dart>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <scene>
      <shadows>false</shadows>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
    </scene>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <!-- gz-sim 8 기본 GUI 구성(/opt/ros/jazzy/opt/gz_sim_vendor/share/gz/gz-sim8/gui/gui.config)을
         그대로 복제하고 ImageDisplay 패널 하나만 덧붙인다. <gui> 블록을 world에 넣으면 gz-sim의
         내장 기본 GUI 설정 전체가 이 블록으로 치환되므로(부분 지정이 아니라 전체 대체), 3D 뷰·
         엔티티 트리·월드 컨트롤 같은 기본 패널을 계속 쓰려면 여기서 전부 다시 선언해야 한다.
         ImageDisplay 는 robot2(mecanum_lift_robot, 유일한 실제 주행 차량)의 시뮬 카메라
         (/robot2/camera/image, bridge.yaml 로 ROS 에도 이미 연결됨)를 기본 토픽으로 물려서,
         task 7 실행 시 맵 전체 3D 뷰 + 차량 1인칭 카메라 뷰가 자동으로 나란히 뜨게 한다. -->
    <gui fullscreen='false'>
      <plugin filename='MinimalScene' name='3D View'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>false</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- 신호지점(북쪽, 0,~38) 바로 위에서 허브+회차루프를 내려다보는 각도.
             예전 z=62 값은 격리된 테스트 월드(코너 4곳에 마커)로 검증한 값이라
             건물 네 모서리는 다 들어왔지만, 실제 navi_factory 전체 맵(남쪽
             도착지까지 포함해 훨씬 큼)에서는 그만큼 멀리 있을 필요가 없었다 —
             오프스크린 카메라 센서로 렌더링해 비교해보니 z=62든 z=24든 어차피
             화면엔 허브+루프 정도만 잡히고(트랙이 남쪽으로 워낙 길어서 한
             프레임에 남쪽 끝까지는 안 들어옴), 24 정도가 확대된 만큼 더
             또렷하게 보여서 이 값으로 낮췄다. -->
        <camera_pose>0 48 24 0 1.006 -1.5708</camera_pose>
      </plugin>
