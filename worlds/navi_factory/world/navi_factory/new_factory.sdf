<sdf version='1.10'>
  <world name='warehouse_fuel'>
    <gravity>0 0 -9.8</gravity>
    <physics name='default_physics' default='false' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <scene>
      <shadows>false</shadows>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <linear>1</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <include>
      <uri>model://warehouse_mohamedazimal27_2x</uri>
      <name>warehouse</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- NW zone: red track, 개별 작업 구역 -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      <name>zone_nw_shelf</name>
      <pose>-13 13 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
      <name>zone_nw_clutter</name>
      <pose>-8 13 0 0 0 0</pose>
    </include>

    <!-- NE zone: blue track, 상자 적재 랙 -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>zone_ne_shelf</name>
      <pose>9 13 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
      <name>zone_ne_bucket</name>
      <pose>13 13 0 0 0 0</pose>
    </include>

    <!-- SW zone: orange track -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfD_01</uri>
      <name>zone_sw_shelf</name>
      <pose>-13 -13 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <name>zone_sw_clutter</name>
      <pose>-8 -13 0 0 0 0</pose>
    </include>

    <!-- SE zone: yellow track, 상자 적재 랙 -->
    <include>
      <uri>model://aws_robomaker_warehouse_ClutteringD_01</uri>
      <name>zone_se_clutter</name>
      <pose>9 -13 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aws_robomaker_warehouse_TrashCanC_01</uri>
      <name>zone_se_trash</name>
      <pose>13 -13 0 0 0 0</pose>
    </include>

    <!-- 지게차 전용 공간 (forklift zone) -->
    <include>
      <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
      <name>forklift_pallet_jack</name>
      <pose>0 -16 0.023266 0 0 0</pose>
    </include>

    <!-- 중앙 대기열 AMR -->
    <include>
      <uri>model://OGV</uri>
      <name>amr_queue_1</name>
      <pose>0 0 0.1 0 0 0</pose>
    </include>

    <!-- AMR 대기열: 중앙 파란색 굵은 선 -->
    <model name='track_center_queue'>
      <static>true</static>
      <pose>0 0 0.03 0 0 -1.5708</pose>
      <link name='link'>
